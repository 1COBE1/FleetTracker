<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Brand & accent -->
    <Color x:Key="Primary">#0B6EF3</Color>
    <Color x:Key="PrimaryDark">#084EB0</Color>
    <Color x:Key="PrimaryLight">#E3F0FF</Color>
    <Color x:Key="Secondary">#00B894</Color>
    <Color x:Key="SecondaryDark">#00906F</Color>
    <Color x:Key="Tertiary">#FFB347</Color>

    <!-- Base & neutrals -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="OffBlack">#101319</Color>

    <Color x:Key="Gray50">#F7F9FC</Color>
    <Color x:Key="Gray100">#E4E7EC</Color>
    <Color x:Key="Gray200">#D0D5DD</Color>
    <Color x:Key="Gray300">#98A2B3</Color>
    <Color x:Key="Gray400">#667085</Color>
    <Color x:Key="Gray500">#475467</Color>
    <Color x:Key="Gray600">#344054</Color>
    <Color x:Key="Gray700">#1D2939</Color>
    <Color x:Key="Gray800">#101828</Color>
    <Color x:Key="Gray900">#0B1120</Color>

    <!-- Surfaces & outlines -->
    <Color x:Key="SurfaceDefault">#FFFFFF</Color>
    <Color x:Key="SurfaceSubtle">#F9FAFB</Color>
    <Color x:Key="SurfaceElevated">#FFFFFF</Color>
    <Color x:Key="SurfaceOutline">#D0D5DD</Color>
    <Color x:Key="SurfaceOutlineStrong">#98A2B3</Color>

    <!-- Semantic -->
    <Color x:Key="Success">#12B981</Color>
    <Color x:Key="SuccessBackground">#ECFDF3</Color>
    <Color x:Key="Warning">#F97316</Color>
    <Color x:Key="WarningBackground">#FFF7ED</Color>
    <Color x:Key="Error">#EF4444</Color>
    <Color x:Key="ErrorBackground">#FEF2F2</Color>
    <Color x:Key="Info">#0EA5E9</Color>
    <Color x:Key="InfoBackground">#E0F2FE</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="PrimaryLightBrush" Color="{StaticResource PrimaryLight}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="SecondaryDarkBrush" Color="{StaticResource SecondaryDark}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>

    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray50Brush" Color="{StaticResource Gray50}"/>
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray700Brush" Color="{StaticResource Gray700}"/>
    <SolidColorBrush x:Key="Gray800Brush" Color="{StaticResource Gray800}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>

    <SolidColorBrush x:Key="SurfaceDefaultBrush" Color="{StaticResource SurfaceDefault}"/>
    <SolidColorBrush x:Key="SurfaceSubtleBrush" Color="{StaticResource SurfaceSubtle}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevated}"/>
    <SolidColorBrush x:Key="SurfaceOutlineBrush" Color="{StaticResource SurfaceOutline}"/>
    <SolidColorBrush x:Key="SurfaceOutlineStrongBrush" Color="{StaticResource SurfaceOutlineStrong}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}"/>
    <SolidColorBrush x:Key="SuccessBackgroundBrush" Color="{StaticResource SuccessBackground}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}"/>
    <SolidColorBrush x:Key="WarningBackgroundBrush" Color="{StaticResource WarningBackground}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>
    <SolidColorBrush x:Key="ErrorBackgroundBrush" Color="{StaticResource ErrorBackground}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}"/>
    <SolidColorBrush x:Key="InfoBackgroundBrush" Color="{StaticResource InfoBackground}"/>

    <!-- Spacing tokens -->
    <Thickness x:Key="SpacingXS">4</Thickness>
    <Thickness x:Key="SpacingS">8</Thickness>
    <Thickness x:Key="SpacingM">12</Thickness>
    <Thickness x:Key="SpacingL">16</Thickness>
    <Thickness x:Key="SpacingXL">24</Thickness>
    <Thickness x:Key="CardPadding">16</Thickness>
    <Thickness x:Key="PageHorizontalPadding">20,0</Thickness>
    <Thickness x:Key="SectionVerticalMargin">16,12</Thickness>

</ResourceDictionary>