<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:MAUI.Views"
       x:Class="MAUI.AppShell">

    <TabBar>
        <ShellContent Title="Map"
                      Icon="map.png"
                      ContentTemplate="{DataTemplate views:MainPage}"
                      Route="map" />

        <ShellContent Title="Trips"
                      Icon="trips.png"
                      ContentTemplate="{DataTemplate views:TripListPage}"
                      Route="trips" />

        <ShellContent Title="Start Trip"
                      Icon="starttrip.png"
                      ContentTemplate="{DataTemplate views:StartTripPage}"
                      Route="starttrip" />

        <ShellContent Title="Vehicles"
                      Icon="vehicle.png"
                      ContentTemplate="{DataTemplate views:RegisterVehiclePage}"
                      Route="registervehicle" />

        <ShellContent Title="Simulator"
              Icon="simulator.png"
              ContentTemplate="{DataTemplate views:SimulatorPage}"
              Route="simulator"/>

    </TabBar>

</Shell>
