<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI.ViewModels"
             xmlns:models="clr-namespace:MAUI.Models"
             x:Class="MAUI.Views.TripReplayPage"
             x:DataType="vm:TripReplayViewModel"
             Title="Trip Replay">

    <Grid RowDefinitions="*, Auto, Auto">

        <!-- Row 0: Map -->
        <WebView x:Name="ReplayMapWebView"
                 Grid.Row="0"
                 Source="replay-map.html"/>

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

        <!-- Row 1: Event log -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}"
                Margin="0,12,0,0"
                Padding="14,10">
            <VerticalStackLayout Spacing="4">

                <!-- Current event summary -->
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0"
                           Text="NOW  "
                           FontSize="10"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           VerticalOptions="Center"/>
                    <Label Grid.Column="1"
                           Text="{Binding CurrentEventDescription}"
                           Style="{StaticResource CardTitleLabelStyle}"
                           FontSize="14"
                           VerticalOptions="Center"/>
                </Grid>

                <!-- Scrollable event log — significant events only -->
                <CollectionView x:Name="EventLogView"
                                ItemsSource="{Binding EventLog}"
                                HeightRequest="90"
                                IsScrollAnimated="False">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="1"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ReplayEventLogItem">
                            <Border Padding="6,3"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 4">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsCurrent}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryLight}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="70, *">
                                    <Label Grid.Column="0"
                                           Text="{Binding Time}"
                                           Style="{StaticResource MetaLabelStyle}"
                                           VerticalOptions="Center"/>
                                    <Label Grid.Column="1"
                                           Text="{Binding Description}"
                                           FontSize="12"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding IsCurrent}"
                                                         Value="True">
                                                <Setter Property="FontAttributes" Value="Bold"/>
                                                <Setter Property="TextColor" Value="{StaticResource PrimaryDark}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </Border>

        <!-- Row 2: Video controls -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="0,12,0,0"
                Padding="16,12">
            <VerticalStackLayout Spacing="8">

                <!-- Trip info + speed picker -->
                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                        <Label Text="{Binding ReplayData.VehicleName}"
                               Style="{StaticResource CardTitleLabelStyle}"
                               FontSize="15"/>
                        <Label Text="{Binding ReplayData.DriverName}"
                               Style="{StaticResource MetaLabelStyle}"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                        <Label Text="Speed"
                               Style="{StaticResource MetaLabelStyle}"
                               FontSize="10"
                               HorizontalOptions="Center"/>
                        <Picker ItemsSource="{Binding SpeedLabels}"
                                SelectedItem="{Binding SelectedSpeedLabel}"
                                WidthRequest="72"
                                HeightRequest="36"
                                FontSize="13"
                                HorizontalOptions="End"/>
                    </VerticalStackLayout>
                </Grid>

                <!-- Progress slider — no binding; driven from code-behind -->
                <Slider x:Name="ReplaySlider"
                        Minimum="0"
                        Maximum="1"
                        DragStarted="OnSliderDragStarted"
                        DragCompleted="OnSliderDragCompleted"
                        ValueChanged="OnSliderValueChanged"
                        Margin="0,-4,0,-4"/>

                <!-- Controls row: current time | ⏮  ▶/⏸ | total duration -->
                <Grid ColumnDefinitions="70, *, Auto, Auto, *, 60" Margin="0,0,0,2">

                    <Label Grid.Column="0"
                           Text="{Binding CurrentTime}"
                           Style="{StaticResource MetaLabelStyle}"
                           VerticalOptions="Center"/>

                    <Button Grid.Column="2"
                            Text="⏮"
                            Command="{Binding RewindCommand}"
                            FontSize="18"
                            WidthRequest="48"
                            HeightRequest="48"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=Black, Dark=White}"
                            BorderWidth="0"
                            Padding="0"/>

                    <Button Grid.Column="3"
                            Text="{Binding PlayPauseIcon}"
                            Command="{Binding PlayPauseCommand}"
                            FontSize="22"
                            WidthRequest="56"
                            HeightRequest="56"
                            Style="{StaticResource PrimaryButtonStyle}"
                            BackgroundColor="{StaticResource Primary}"
                            TextColor="{StaticResource White}"
                            CornerRadius="28"
                            Padding="0"/>

                    <Label Grid.Column="5"
                           Text="{Binding TotalTime}"
                           Style="{StaticResource MetaLabelStyle}"
                           HorizontalOptions="End"
                           VerticalOptions="Center"/>

                </Grid>

            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>
