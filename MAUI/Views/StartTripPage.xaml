<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI.ViewModels"
             xmlns:models="clr-namespace:MAUI.Models"
             x:Class="MAUI.Views.StartTripPage"
             x:DataType="vm:StartTripViewModel"
             Title="Start Trip">

    <ScrollView>
        <VerticalStackLayout Padding="0,16" Spacing="16">

            <!-- Vehicle -->
            <Label Text="Vehicle" Style="{StaticResource SectionHeaderLabelStyle}" FontSize="14"/>
            <Border Style="{StaticResource FieldContainerStyle}">
                <Picker ItemsSource="{Binding Vehicles}"
                        SelectedItem="{Binding SelectedVehicle}"
                        ItemDisplayBinding="{Binding VehicleName}"
                        Title="Select a vehicle"/>
            </Border>

            <!-- Driver -->
            <Label Text="Driver name" Style="{StaticResource SectionHeaderLabelStyle}" FontSize="14"/>
            <Border Style="{StaticResource FieldContainerStyle}">
                <Entry Placeholder="Enter driver name"
                       Text="{Binding DriverName}"/>
            </Border>

            <!-- Stop input -->
            <Label Text="Stops" Style="{StaticResource SectionHeaderLabelStyle}" FontSize="14"/>
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Border Grid.Column="0" Style="{StaticResource FieldContainerStyle}">
                    <Entry Placeholder="Stop name (e.g. Warehouse A)"
                           Text="{Binding NewStopName}"/>
                </Border>
                <Button Grid.Column="1"
                        Text="Pick on Map"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding PickStopLocationCommand}"/>
            </Grid>

            <!-- Added stops list -->
            <CollectionView ItemsSource="{Binding Stops}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:StopInputModel">
                        <Border Style="{StaticResource CardStyle}" Margin="0,8" Padding="14">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Name}" Style="{StaticResource CardTitleLabelStyle}" FontSize="15"/>
                                    <Label Text="{Binding Address}" Style="{StaticResource MetaLabelStyle}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1"
                                        Text="✕"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StartTripViewModel}}, Path=RemoveStopCommand}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Start Trip"
                    Command="{Binding StartTripCommand}"/>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
