<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI.ViewModels"
             xmlns:models="clr-namespace:MAUI.Models"
             x:Class="MAUI.Views.TripHistoryPage"
             x:DataType="vm:TripHistoryViewModel"
             Title="Trip History">

    <Grid RowDefinitions="*, Auto">

        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding CompletedTrips}"
                        x:Name="TripList">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                    <Label Text="No completed trips yet"
                           FontSize="16"
                           TextColor="Gray"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TripModel">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8">
                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8">

                            <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                                <Label Text="{Binding VehicleName}"
                                       Style="{StaticResource CardTitleLabelStyle}"/>
                                <Label Text="{Binding DriverName}"
                                       Style="{StaticResource MetaLabelStyle}"/>
                            </VerticalStackLayout>

                            <Border Grid.Row="0" Grid.Column="1"
                                    Style="{StaticResource StatusPillStyle}"
                                    HorizontalOptions="End"
                                    BackgroundColor="{StaticResource SuccessBackground}">
                                <Label Text="{Binding Status}"
                                       Style="{StaticResource StatusPillLabelStyle}"
                                       TextColor="{StaticResource Success}"/>
                            </Border>

                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Distance" Style="{StaticResource MetaLabelStyle}"/>
                                    <Label Text="{Binding DistanceTraveled, StringFormat='{0:F1} km'}"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Stops" Style="{StaticResource MetaLabelStyle}"/>
                                    <Label Text="{Binding StopsCompleted, StringFormat='{0}'}"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="End">
                                    <Label Text="Alerts" Style="{StaticResource MetaLabelStyle}" HorizontalOptions="End"/>
                                    <Label Text="{Binding AlertsCount, StringFormat='{0}'}"
                                           FontAttributes="Bold"
                                           HorizontalOptions="End"/>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                  ColumnDefinitions="*,Auto"
                                  Margin="0,2,0,0">
                                <Label Grid.Column="0"
                                       Text="{Binding EndedAt, StringFormat='Ended {0:MMM dd · HH:mm}'}"
                                       Style="{StaticResource MetaLabelStyle}"
                                       VerticalOptions="Center"/>
                                <Button Grid.Column="1"
                                        Text="Replay"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14,8"
                                        CornerRadius="999"
                                        CommandParameter="{Binding TripId}"
                                        Clicked="OnReplayClicked"/>
                            </Grid>

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="0"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>

    </Grid>
</ContentPage>
