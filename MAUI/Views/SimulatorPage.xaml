<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI.ViewModels"
             x:Class="MAUI.Views.SimulatorPage"
             x:DataType="vm:SimulatorViewModel"
             Title="Simulator">

    <Grid RowDefinitions="250, *">

        <WebView x:Name="SimMapWebView"
                 Grid.Row="0"
                 Source="map.html"/>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,16" Spacing="16">

                <Label Text="Active trip" Style="{StaticResource SectionHeaderLabelStyle}" FontSize="14"/>
                <Border Style="{StaticResource FieldContainerStyle}">
                    <Picker ItemsSource="{Binding ActiveTrips}"
                            SelectedItem="{Binding SelectedTrip}"
                            ItemDisplayBinding="{Binding VehicleName}"
                            Title="Select a trip"/>
                </Border>

                <Button Text="Load Stops"
                        Command="{Binding InitializeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsEnabled="{Binding IsNotRunning}"/>

                <Label Text="{Binding SpeedMultiplier, StringFormat='Speed multiplier: {0}x'}"
                       Style="{StaticResource SectionHeaderLabelStyle}"
                       FontSize="14"/>
                <Slider Minimum="1" Maximum="20"
                        Value="{Binding SpeedMultiplier}"
                        IsEnabled="{Binding IsNotRunning}"/>

                <Border Style="{StaticResource CardStyle}" Padding="14">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding StatusText}" Style="{StaticResource CardTitleLabelStyle}" FontSize="14"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="{Binding CurrentLatitude,  StringFormat='Lat {0:F6}'}"
                                   Style="{StaticResource MetaLabelStyle}"/>
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentLongitude, StringFormat='Lng {0:F6}'}"
                                   Style="{StaticResource MetaLabelStyle}"
                                   HorizontalOptions="End"/>
                        </Grid>
                        <ProgressBar Progress="{Binding WaypointRatio}"/>

                        <Label Text="{Binding WaypointProgress, StringFormat='{0} waypoints sent'}"
                               Style="{StaticResource MetaLabelStyle}"/>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="▶ Start"
                            Command="{Binding StartCommand}"
                            IsEnabled="{Binding IsNotRunning}"
                            Style="{StaticResource PrimaryButtonStyle}"/>
                    <Button Grid.Column="1"
                            Text="⏹ Stop"
                            Command="{Binding StopCommand}"
                            IsEnabled="{Binding IsRunning}"
                            Style="{StaticResource DestructiveButtonStyle}"/>
                    <Button Grid.Column="2"
                            Text="↺ Reset"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding IsNotRunning}"
                            Style="{StaticResource SecondaryButtonStyle}"/>
                </Grid>

                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center"/>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
