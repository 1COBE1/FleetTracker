<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MAUI.ViewModels"
             xmlns:models="clr-namespace:MAUI.Models"
             x:Class="MAUI.Views.TripDetailsPage"
             x:DataType="vm:TripDetailsViewModel"
             Title="Trip Details">

    <Grid RowDefinitions="300, *">

        <!-- Trip Map -->
        <WebView x:Name="TripMapWebView"
                 Grid.Row="0"
                 Source="trip-map.html"/>

        <!-- Scrollable details below map -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,16" Spacing="16">

                <!-- Summary -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10">
                        <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Trip.VehicleName}"
                                   Style="{StaticResource PageTitleLabelStyle}"
                                   FontSize="22"/>
                            <Label Text="{Binding Trip.DriverName}"
                                   Style="{StaticResource MetaLabelStyle}"/>
                        </VerticalStackLayout>

                        <Border Grid.Row="0" Grid.Column="1"
                                Style="{StaticResource StatusPillStyle}"
                                HorizontalOptions="End">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Trip.Status}" Value="InProgress">
                                    <Setter Property="BackgroundColor" Value="{StaticResource InfoBackground}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Trip.Status}" Value="Completed">
                                    <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}"/>
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding Trip.Status}" Value="Cancelled">
                                    <Setter Property="BackgroundColor" Value="{StaticResource ErrorBackground}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <Label Text="{Binding Trip.Status}"
                                   Style="{StaticResource StatusPillLabelStyle}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding Trip.Status}" Value="InProgress">
                                        <Setter Property="TextColor" Value="{StaticResource Info}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Trip.Status}" Value="Completed">
                                        <Setter Property="TextColor" Value="{StaticResource Success}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding Trip.Status}" Value="Cancelled">
                                        <Setter Property="TextColor" Value="{StaticResource Error}"/>
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>

                        <!-- Key metrics row -->
                        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              ColumnDefinitions="*,*,*,*"
                              ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Distance" Style="{StaticResource MetaLabelStyle}"/>
                                <Label Text="{Binding Trip.DistanceTraveled, StringFormat='{0:F1} km'}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Speed" Style="{StaticResource MetaLabelStyle}"/>
                                <Label Text="{Binding Trip.CurrentSpeed, StringFormat='{0:F0} km/h'}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2">
                                <Label Text="Stops" Style="{StaticResource MetaLabelStyle}"/>
                                <Label Text="{Binding Trip.StopsCompleted, StringFormat='{0}'}"
                                       FontAttributes="Bold"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="End">
                                <Label Text="ETA" Style="{StaticResource MetaLabelStyle}" HorizontalOptions="End"/>
                                <Label Text="{Binding Trip.EstimatedArrival, StringFormat='{0:HH:mm}'}"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Primary actions -->
                        <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                              ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Replay"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Clicked="OnReplayClicked"/>
                            <Button Grid.Column="1"
                                    Text="End Trip"
                                    Style="{StaticResource DestructiveButtonStyle}"
                                    Command="{Binding EndTripCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding Trip.Status}" Value="Completed">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Button" Binding="{Binding Trip.Status}" Value="Cancelled">
                                        <Setter Property="IsVisible" Value="False"/>
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Stops -->
                <Label Text="Stops" Style="{StaticResource SectionHeaderLabelStyle}"/>
                <CollectionView ItemsSource="{Binding Stops}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:TripStopModel">
                            <Border Style="{StaticResource CardStyle}" Margin="0,8" Padding="14">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Active">
                                        <Setter Property="BackgroundColor" Value="{StaticResource WarningBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger TargetType="Border" Binding="{Binding Status}" Value="Completed">
                                        <Setter Property="BackgroundColor" Value="{StaticResource SuccessBackground}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                                    <Border Grid.Column="0"
                                            Style="{StaticResource StatusPillStyle}"
                                            Padding="10,6"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray800}}">
                                        <Label Text="{Binding SequenceNumber}"
                                               FontAttributes="Bold"/>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource CardTitleLabelStyle}"
                                               FontSize="15"/>
                                        <Label Text="{Binding Address}"
                                               Style="{StaticResource MetaLabelStyle}"/>
                                        <Label Text="{Binding Status}" Style="{StaticResource MetaLabelStyle}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Pending">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Active">
                                                    <Setter Property="TextColor" Value="{StaticResource Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="TextColor" Value="{StaticResource Success}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding EstimatedArrival, StringFormat='ETA {0:HH:mm}'}"
                                               Style="{StaticResource MetaLabelStyle}"
                                               IsVisible="True">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="IsVisible" Value="False"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                        <Label Text="{Binding ActualArrival, StringFormat='Arrived {0:HH:mm}'}"
                                               Style="{StaticResource MetaLabelStyle}"
                                               TextColor="{StaticResource Success}"
                                               IsVisible="False">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding Status}" Value="Completed">
                                                    <Setter Property="IsVisible" Value="True"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Alerts -->
                <Label Text="Safety Alerts" Style="{StaticResource SectionHeaderLabelStyle}"/>
                <CollectionView ItemsSource="{Binding Alerts}"
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SafetyAlertModel">
                            <Border Style="{StaticResource CardStyle}" Margin="0,8" Padding="14">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding AlertType}"
                                           Style="{StaticResource CardTitleLabelStyle}"
                                           TextColor="{StaticResource Error}"/>
                                    <Label Text="{Binding OccurredAt, StringFormat='{0:MMM dd · HH:mm:ss}'}"
                                           Style="{StaticResource MetaLabelStyle}"/>
                                    <Label Text="{Binding DecelerationG, StringFormat='{0:F2}G'}"
                                           Style="{StaticResource MetaLabelStyle}"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray700}, Dark={StaticResource Gray200}}"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
